# ---------------------------------------------------------------------------
# Web app (apps/web) — read at build time by Vite
# ---------------------------------------------------------------------------

# "mock" runs the in-browser showcase backend (Phase A, no server needed).
# "http" talks to the real API in apps/api (Phase B).
VITE_API_MODE=mock

# Base URL of the real API when VITE_API_MODE=http.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# API and worker (apps/api) — Phase B. Documented here so the contract is clear.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://hco:hco@localhost:5432/hco_crm
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET=generate-32-random-bytes
# ENCRYPTION_KEY=generate-32-random-bytes-base64   # encrypts channel tokens at rest
# DEMO_MODE=true                                   # enables /dev/simulate/* routes and the demo panel
# PUBLIC_BASE_URL=https://crm.example.com

# Meta (Phase C)
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_API_VERSION=v26.0

# Google / Gmail (Phase C)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
